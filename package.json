{
  "name": "royal-post",
  "version": "0.1.0",
  "private": true,
  "description": "Royal Post — you are the royal pigeon carrying letters between a florid prince and a terse princess on a tiny planet. NYU Game Design, Week 5.",
  "type": "module",
  "scripts": {
    "dev": "node tools/serve.mjs",
    "test": "node --test tests/*.test.js",
    "test:e2e": "node --test --test-concurrency=1 e2e/smoke.test.mjs",
    "shots": "SHOTS=1 node --test --test-concurrency=1 e2e/smoke.test.mjs",
    "build": "node tools/build.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "UNLICENSED",
  "devDependencies": {
    "playwright-core": "^1.64.0"
  }
}
